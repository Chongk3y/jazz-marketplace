# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git — never commit real keys.
# On Vercel, add the same names under Settings → Environment Variables.

# --- Supabase (database + photo storage) ---------------------------------
# Supabase dashboard → Project Settings → API Keys. Set BOTH or NEITHER.
SUPABASE_URL=
# Use a SECRET key (starts with sb_secret_…) or the legacy "service_role" key.
# Server-only: it is never sent to the browser. Do not use the publishable/anon key.
SUPABASE_SECRET_KEY=

# --- Stripe (payments, sandbox only) --------------------------------------
# The sandbox secret key (sk_test_…). Server-only.
STRIPE_SECRET_KEY=
# Signing secret (whsec_…) printed by `npm run stripe:webhook -- https://your-site`.
# Needed on the deployed site so the webhook can verify Stripe's messages.
STRIPE_WEBHOOK_SECRET=

# --- Site address (optional) ----------------------------------------------
# Where Stripe sends people back after checkout/onboarding. If empty, the
# address of the current request is used (works on localhost and Vercel).
NEXT_PUBLIC_SITE_URL=
