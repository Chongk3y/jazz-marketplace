# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git — never commit real keys.
#
# Leave everything blank to run fully locally (data in .data/, no real emails).

# --- Supabase (database + photo storage) ---------------------------------
# Supabase dashboard → Project Settings → API (or "Data API" / "API Keys").
# Set BOTH or NEITHER.
SUPABASE_URL=
# Use a SECRET key (starts with sb_secret_…) or the legacy "service_role" key.
# Server-only: it is never sent to the browser. Do not use the publishable/anon key.
SUPABASE_SECRET_KEY=

# --- Email to sellers (optional, via Resend) -------------------------------
# Without these, seller emails are only saved and shown at /messages.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Marketplace <hello@yourdomain.com>".
# For quick tests Resend allows "onboarding@resend.dev", but only to your own address.
EMAIL_FROM=
